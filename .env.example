# 默认连接本地后端。设为 false 可离线预览占位页面。
NUXT_PUBLIC_API_ENABLED=true
# 后端需允许 http://localhost:6002 的 CORS 凭据请求；Google 开发来源也使用 localhost。
# 本地绝对地址；生产设为 /api。
NUXT_PUBLIC_API_BASE=http://localhost:6001/api
# SSR 仅使用绝对地址读取公开 API。
NUXT_API_BASE=http://localhost:6001/api
NUXT_PUBLIC_SITE_URL=https://speakquant.com
# 深色设计尚未确认，默认不开放选择入口。true 可检查主题基础设施。
NUXT_PUBLIC_ENABLE_DARK_THEME=false

# 首发不开放运行包下载，明确开放后才能改为 true。
NUXT_PUBLIC_ENABLE_RUNNER_DOWNLOAD=false
# 默认使用已确认公司身份；部署时可覆盖。注册地址为注册代理地址，不代表实际办公地址。
NUXT_PUBLIC_OPERATOR_NAME="Nanhao Labs Inc"
NUXT_PUBLIC_OPERATOR_REGISTRATION_NUMBER=2026-002089918
NUXT_PUBLIC_OPERATOR_REGISTERED_ADDRESS="30 N Gould St Ste R, Sheridan, WY 82801, United States"
NUXT_PUBLIC_SUPPORT_EMAIL=support@speakquant.com

# 可选的正式政策外链覆盖；留空使用站内对应语言页面。
NUXT_PUBLIC_TERMS_URL=
NUXT_PUBLIC_PRIVACY_URL=
