# 默认占位模式：可独立访问所有页面，不发送后端业务请求。
NUXT_PUBLIC_API_ENABLED=false
# 联调时设为 true，并让后端允许 http://127.0.0.1:6002 的 CORS 凭据请求。
# 本地绝对地址；生产设为 /api。
NUXT_PUBLIC_API_BASE=http://127.0.0.1:6001/api
# SSR 仅使用绝对地址读取公开 API。
NUXT_API_BASE=http://127.0.0.1:6001/api
NUXT_PUBLIC_SITE_URL=http://127.0.0.1:6002
# 深色设计尚未确认，默认不开放选择入口。true 可检查主题基础设施。
NUXT_PUBLIC_ENABLE_DARK_THEME=false
